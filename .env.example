# Public client configuration. Required in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used only when deleting the Supabase auth user.
SUPABASE_SERVICE_ROLE_KEY=

# Optional OpenAI-compatible explanation API. Measurements never call this.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional. Defaults to 10.
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# Development only. Set FACELAB_DEV_AUTH=0 to disable the local sign-in form.
FACELAB_DEV_AUTH=
FACELAB_DEV_SECRET=
FACELAB_DATA_DIR=
