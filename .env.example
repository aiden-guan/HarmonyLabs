# Public Convex deployment URL. Required in production.
# `npx convex dev` writes this for local development.
NEXT_PUBLIC_CONVEX_URL=

# Optional OpenAI-compatible explanation API. Measurements never call this.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional. Defaults to 10.
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# Development only. Set HARMONYLABS_DEV_AUTH=0 to disable the local sign-in form.
HARMONYLABS_DEV_AUTH=
HARMONYLABS_DEV_SECRET=
HARMONYLABS_DATA_DIR=
